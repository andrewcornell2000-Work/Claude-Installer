# Claude-Installer configuration.
# Copy this file to .env in the repo root and fill in what you need.
# .env is gitignored. Never commit real tokens.
#
# Claude Code auth is handled by CLI login, not by a key here:
#   claude auth login

# ── Identity ──────────────────────────────────────────────────────────────────
# Written into ~/.claude/CLAUDE.md so Claude knows who you are.
CLAUDE_USER_EMAIL=you@example.com

# ── Paths ─────────────────────────────────────────────────────────────────────
# Folder the filesystem MCP is scoped to. Must be an absolute path that exists.
# Leave unset and the installer will try to auto-detect a "* Finance - General"
# folder under your OneDrive, then fall back to your user profile.
# CLAUDE_FINANCE_DIR=C:\Users\you\OneDrive - Org\MCL Finance - General

# ── Bucket selection ──────────────────────────────────────────────────────────
# Which MCP buckets to install. Comma-separated, or "all".
# Profiles: work (default) | analyst | minimal   -- see claude.manifest.json
# CLAUDE_BUCKETS=core,powerbi,data,web,webdev

# ── MCP server secrets ────────────────────────────────────────────────────────
# A server whose required key is missing is skipped with a printed reason.

# GitHub MCP (required for the github server) - repos, PRs, issues, code search.
# Create at https://github.com/settings/tokens  (classic: repo scope, or fine-grained)
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# Context7 (optional) - works without a key; a key raises rate limits.
# CONTEXT7_API_KEY=

# Parallel search (optional) - higher rate limits.
# PARALLEL_API_KEY=

# Firecrawl (required for the firecrawl server) - https://www.firecrawl.dev/app/api-keys
# FIRECRAWL_API_KEY=fc-...

# fal.ai (required for the fal-ai server) - image/video/audio generation.
# FAL_KEY=

# Supabase (required for the supabase server) - Dashboard > Settings > General > Reference ID
# SUPABASE_PROJECT_REF=

# ── Tuning ────────────────────────────────────────────────────────────────────
# Cells per excel MCP response. Roughly 8 tokens per cell, so 5000 is already
# about 40k tokens in a single tool result. Raising this is rarely the right fix
# for a large workbook - narrow the range or aggregate in Python instead.
# EXCEL_MCP_PAGING_CELLS_LIMIT=5000
